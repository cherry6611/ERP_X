DATABASE_URL=
JWT_SECRET=
SECRET_ENC_KEY=
BOOTSTRAP_ADMIN_USERNAME=
# 首次建库时使用；必须 ≥12 位且含大小写/数字/符号（代码会强制校验，弱口令会阻止启动）
BOOTSTRAP_ADMIN_PASSWORD=
# docker compose postgres 服务（开箱必填）
POSTGRES_USER=erp
POSTGRES_PASSWORD=
POSTGRES_DB=shengseerp
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 本地开发建议 http://127.0.0.1:3000/api/auth/feishu/callback（与 APP_BASE_URL 宿主一致，勿混用 localhost）
FEISHU_REDIRECT_URI=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_COST_TABLE=
FEISHU_BITABLE_CONTRACT_TABLE=
FEISHU_BITABLE_TIMESHEET_TABLE=
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
SERVER_HOST=0.0.0.0
SERVER_PORT=3000
CLIENT_BASE_PATH=/
VITE_API_BASE=
UPLOAD_DIR=data/uploads
# 若设置，Nest 日志额外以 JSON Lines 追加写入该目录（如 ./logs）；未设置则仅控制台。
LOG_DIR=
# 反代层数；compose 默认 1。本地直连可不设。
# 直接暴露 3000 时保持 0（防 X-Forwarded-For 伪造）；Nginx/SLB 前置时设 1
TRUST_PROXY_HOPS=0
APP_BASE_URL=
ENABLE_SCHEDULER=
FEISHU_FALLBACK_RECEIVER=
# 仅本地联调；生产禁止开启。生产环境即使设为 true 也会被代码拒绝。
FEISHU_ALLOW_UNVERIFIED_EVENTS=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# ── 飞书云空间 / 知识库（feishu-drive）───────────────────────────────
# 两个都可不填：不填时 /drive 与 /wiki 会渲染"未配置"引导页并禁用写操作
# （不会再假装"当前文件夹为空"）。凭证也可在设置页写入 comp_feishu_drive_config。
FEISHU_ROOT_FOLDER_TOKEN=
FEISHU_WIKI_SPACE_ID=
# 报价单从多维表格导入时用；出向同步用上面的 FEISHU_BITABLE_*_TABLE
FEISHU_BITABLE_QUOTATION_TABLE=

# ── 运行模式（生产必设）─────────────────────────────────────────────
# NODE_ENV=production 会启用生产护栏：弱 JWT_SECRET / SECRET_ENC_KEY 直接拒绝启动，
# 且 FEISHU_ALLOW_UNVERIFIED_EVENTS 即使为 true 也被忽略。
NODE_ENV=production
# 仅本地联调：允许生产环境下也用弱密钥。生产**不要**设置。
ALLOW_WEAK_SECRETS=
# 反向代理下浏览器来源与 APP_BASE_URL 不同源时必须显式列出（逗号分隔），否则跨域登录会失败
CORS_ORIGIN=
# 健康检查里回报的版本号，便于"线上跑的是哪个构建"可查
GIT_SHA=
# 生产用 connection（每请求一条预留连接，事务/savepoint 语义完整）。
# 仅高并发只读压测可改 transaction。默认已是最稳的一档，一般不要动。
PER_REQUEST_TX=connection

# ── 行级数据权限兜底（B-02）────────────────────────────────────────
# 收窄规则存在但取不到值时：fail_closed（默认，返回空集）| allow（放行，仅调试用）
DATA_SCOPE_UNCONFIGURED_POLICY=fail_closed
# 设为 1 时，合同生效会自动创建对应项目；不设则需手工立项
AUTO_CREATE_PROJECT=

# ── 导出目录 ───────────────────────────────────────────────────────
# 不设则落在 UPLOAD_DIR/exports
EXPORT_DIR=

# ── 附件内容扫描（B-06）────────────────────────────────────────────
# none（默认，扫描结论记 skipped 而非 clean）| clamav | http
FILE_SCAN_PROVIDER=none
# FILE_SCAN_PROVIDER=http 时必填
FILE_SCAN_URL=
FILE_SCAN_TOKEN=

# ── 发票查验（可插拔）───────────────────────────────────────────────
# none（默认，人工核对）| http-vendor
INVOICE_VERIFY_PROVIDER=none
# INVOICE_VERIFY_PROVIDER=http-vendor 时必填
INVOICE_VERIFY_BASE_URL=
INVOICE_VERIFY_API_KEY=
INVOICE_VERIFY_TIMEOUT_MS=8000

# ── Swagger（默认关闭；生产**不要**开启）────────────────────────────
# 开启时必须同时给 SWAGGER_USER / SWAGGER_PASSWORD，否则接口文档裸奔
SWAGGER_ENABLED=false
SWAGGER_USER=
SWAGGER_PASSWORD=
