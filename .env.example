DATABASE_URL=
JWT_SECRET=
SECRET_ENC_KEY=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
# docker compose postgres 服务（开箱必填）
POSTGRES_USER=erp
POSTGRES_PASSWORD=
POSTGRES_DB=shengseerp
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 本地开发建议 http://127.0.0.1:3000/api/auth/feishu/callback（与 APP_BASE_URL 宿主一致，勿混用 localhost）
FEISHU_REDIRECT_URI=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_COST_TABLE=
FEISHU_BITABLE_CONTRACT_TABLE=
FEISHU_BITABLE_TIMESHEET_TABLE=
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
SERVER_HOST=0.0.0.0
SERVER_PORT=3000
CLIENT_BASE_PATH=/
VITE_API_BASE=
UPLOAD_DIR=data/uploads
# 若设置，Nest 日志额外以 JSON Lines 追加写入该目录（如 ./logs）；未设置则仅控制台。
LOG_DIR=
# 反代层数；compose 默认 1。本地直连可不设。
TRUST_PROXY_HOPS=1
APP_BASE_URL=
ENABLE_SCHEDULER=
FEISHU_FALLBACK_RECEIVER=
# 仅本地联调；生产禁止开启。生产环境即使设为 true 也会被代码拒绝。
FEISHU_ALLOW_UNVERIFIED_EVENTS=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
