{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "types": ["jest", "node"],
    "noEmit": true,
    "paths": {
      "@server/*": ["server/*"],
      "@shared/*": ["shared/*"],
      "@client/*": ["client/*"]
    }
  },
  "include": [
    "server/**/*.ts",
    "shared/**/*.ts",
    "server/**/*.spec.ts"
  ],
  "exclude": ["node_modules", "dist", "client"]
}
